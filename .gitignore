# Rust build artifacts (regenerate via `cargo test --workspace` at repo root)
target/

# Node working tree — the node lives in its own repository
# (github.com/kdsmith18542/LuckyLode-node); a local clone is kept here
# for development and never tracked inside this repo.
verus/

# OS noise
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets & environment — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.secrets/

# Agent/tooling config (may contain personal instructions — keep local)
.kilo/
.kilocode/
.opencode/

# Logs & crash dumps
*.log
core.*

# Internal planning — decision records, work plans, process history.
# Never public: designs/specs live at the repo root; planning lives here.
internal/

# Agent files are local-only (the public repo carries designs + code)
AGENTS.md

# Wallet UI build artifacts — regenerated by `npm --prefix lm-wallet/ui run build`
# (the Tauri binary snapshots them at build time; never track them)
lm-wallet/ui/node_modules/
lm-wallet/ui/dist/

# Android build outputs
lm-mobile/android/app/build/
lm-mobile/android/.gradle/
lm-mobile/android/build/
lm-mobile/android/app/src/main/jniLibs/*/
wiki/dist/
